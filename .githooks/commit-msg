#!/usr/bin/env sh
# Validates the commit message subject against Conventional Commits
# (https://www.conventionalcommits.org/), mirroring the header-length,
# subject-full-stop, and subject-case rules from commitlint.config.cjs's
# @commitlint/config-conventional that a dependency-free POSIX check can
# approximate. Body/footer rules are out of scope; CI's commitlint job
# (.github/workflows/commitlint.yml) remains authoritative. Enabled via:
#   git config core.hooksPath .githooks
set -eu
export LC_ALL=C

msg_file="$1"
first_line=$(head -n1 "$msg_file")

# Trim trailing whitespace (spaces, tabs, and a stray \r left by CRLF line
# endings): git's default "strip" cleanup mode removes this from the subject
# AFTER this hook runs, so checking the untrimmed text can both accept what
# git will go on to store as ending in a period, and reject a header that's
# within the limit once the trailing whitespace is gone.
first_line=$(printf '%s' "$first_line" | sed -E 's/[[:space:]]+$//')

case "$first_line" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

fail() {
  echo "commit-msg: $1" >&2
  echo "  $first_line" >&2
  exit 1
}

# Count UTF-16 code units, matching commitlint's JS String.length: strip
# UTF-8 continuation bytes (10xxxxxx) to get codepoints, then add one per
# 4-byte-lead byte (\360-\364, i.e. codepoints >= U+10000), each of which
# encodes as a UTF-16 surrogate pair (2 units) instead of 1.
codepoints=$(printf '%s' "$first_line" | tr -d '\200-\277' | wc -c)
astral=$(printf '%s' "$first_line" | tr -dc '\360-\364' | wc -c)
header_len=$((codepoints + astral))
[ "$header_len" -le 100 ] || fail "subject must not be longer than 100 characters"

pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-zA-Z0-9_./-]+\))?!?: .+'

if ! printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  echo "commit-msg: subject does not follow Conventional Commits:" >&2
  echo "  $first_line" >&2
  echo "  expected: type(scope)?: description" >&2
  echo "  types: build chore ci docs feat fix perf refactor revert style test" >&2
  exit 1
fi

description=${first_line#*: }

case "$description" in
  *...) : ;; # ellipsis is exempt, matching commitlint's subject-full-stop
  *.) fail "subject must not end with a period" ;;
esac

case "$description" in
  [[:upper:]]*) fail "subject must not start with an uppercase letter" ;;
esac
